{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "custom/codemirror-block",
  "version": "1.0.0",
  "title": "Luiz0067 Editor",
  "category": "formatting",
  "icon": "editor-code",
  "description": "Native professional code editor block with authorial syntax highlighting.",
  "keywords": [
    "code",
    "syntax highlighting",
    "editor",
    "developer"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "code": {
      "type": "string",
      "default": ""
    },
    "language": {
      "type": "string",
      "default": "javascript"
    },
    "theme": {
      "type": "string",
      "default": "default"
    }
  },
  "textdomain": "luiz0067-editor",
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/index.css",
  "style": "file:./build/style-index.css"
}
